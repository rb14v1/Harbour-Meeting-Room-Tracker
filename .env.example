# Copy to .env and adjust. Never commit .env.

# Backend
# SQLite file path. Inside Docker this is overridden to /app/data/meeting_rooms.db.
MRT_DB_PATH=./data/meeting_rooms.db
# Comma-separated list of origins allowed to call the API directly (dev server, etc.)
MRT_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend (build-time). Leave default when using the Vite proxy or the nginx container.
VITE_API_BASE=/api

# Docker
FRONTEND_PORT=8080
