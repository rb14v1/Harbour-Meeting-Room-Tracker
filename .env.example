# Copy to backend\.env and fill in. Never commit the real .env.

# PostgreSQL (local install)
DB_NAME=meeting_rooms
DB_USER=meeting_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_TIME_ZONE=Asia/Kolkata

# Allowed browser origins for the API (Vite dev server and the optional nginx port)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Azure only (leave unset locally)
# DB_SSLMODE=require
# DJANGO_BEHIND_PROXY=1
# CSRF_TRUSTED_ORIGINS=https://<backend-fqdn>
# RUN_MIGRATIONS=1
